{
  "name": "@gravity/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "run-p dev:renderer dev:main dev:preload dev:electron",
    "dev:renderer": "vite",
    "dev:main": "tsc -b tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -b tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://127.0.0.1:5173 dist-electron/main/index.js dist-electron/preload/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "run-s clean build:main build:preload build:renderer",
    "build:main": "tsc -b --force tsconfig.main.json",
    "build:preload": "tsc -b --force tsconfig.preload.json",
    "build:renderer": "vite build",
    "clean": "rimraf dist dist-electron",
    "test:e2e": "run-s build test:e2e:rebuild-native test:e2e:run",
    "test:e2e:rebuild-native": "corepack pnpm --workspace-root rebuild:native",
    "test:e2e:run": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@gravity/adapters": "workspace:*",
    "@gravity/application": "workspace:*",
    "@gravity/domain": "workspace:*",
    "@mariozechner/pi-agent-core": "^0.72.0",
    "@mariozechner/pi-ai": "^0.72.0",
    "@mariozechner/pi-web-ui": "^0.72.0",
    "@tailwindcss/vite": "^4.2.4",
    "framer-motion": "^12.38.0",
    "highlight.js": "11.11.1",
    "lucide-react": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "cross-env": "^10.1.0",
    "electron": "41.7.0"
  }
}
