{
  "name": "gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:electron": "node scripts/ensure-electron.mjs",
    "predev": "run-s prepare:electron rebuild:native",
    "dev": "corepack pnpm --filter @gravity/desktop dev",
    "build": "run-s build:packages build:desktop",
    "build:packages": "tsc -b --force packages/domain packages/application packages/adapters packages/testkit",
    "build:desktop": "corepack pnpm --filter @gravity/desktop build",
    "postinstall": "run-s prepare:electron rebuild:native",
    "pretest": "corepack pnpm --filter @gravity/adapters rebuild better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -b --force",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:e2e": "corepack pnpm --filter @gravity/desktop test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "framer-motion": "^12.38.0"
  }
}
